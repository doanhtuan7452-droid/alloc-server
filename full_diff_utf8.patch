+                // Kß╗╣ n─âng chi tiß║┐t
+                skills = skills,
+
+                // Khß╗æi l╞░ß╗úng c├┤ng viß╗çc
+                currentWorkload = new
+                {
+                    activeTaskCount = workload?.ActiveTaskCount ?? 0,
+                    currentWorkloadValue = workload?.CurrentWorkloadValue ?? 0
