+            catch (Exception ex)
+            {
+                return AIToolResult.Failure(400, "INVALID_PAYLOAD", $"Payload kh├┤ng hß╗úp lß╗ç: {ex.Message}");
+            }
+
+            // T├¼m Project
+            var project = await _context.Projects
+                .FirstOrDefaultAsync(p => p.ProjectID == payload.ProjectId && !p.IsDeleted);
+
+            if (project == null)
+            {
+                return AIToolResult.Failure(404, "PROJECT_NOT_FOUND", $"Kh├┤ng t├¼m thß║Ñy dß╗▒ ├ín c├│ ID {payload.ProjectId} hoß║╖c dß╗▒ ├ín ─æ├ú bß╗ï x├│a.");
