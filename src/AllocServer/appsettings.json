{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_DB_SERVER;Database=ALLOC;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;",
    "Redis": "YOUR_REDIS_HOST:6379"
  },
  "JwtSettings": {
    "SecretKey": "YOUR_SUPER_SECRET_KEY_DO_NOT_SHARE",
    "Issuer": "DemoWebAPI",
    "Audience": "DemoWebAPIClient",
    "AccessTokenExpirationMinutes": 20,
    "RefreshTokenExpirationDays": 7
  },
  "GoogleSettings": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
  },
  "FeatureToggles": {
    "EnableStrictQuotaCheck": false
  },
  "Firebase": {
    "Enabled": false,
    "AppName": "AllocServerNotifications",
    "ProjectId": "",
    "CredentialPath": "",
    "ServiceAccountJson": ""
  },
  "Storage": {
    "Provider": "AzureBlob",
    "AzureBlob": {
      "ConnectionString": "YOUR_AZURE_BLOB_CONNECTION_STRING",
      "ContainerName": "project-assets"
    }
  },
  "TimesheetSettings": {
    "StandardHoursPerMonth": 160
  },
  "RateLimiting": {
    "Global": {
      "TokenLimit": 100,
      "TokensPerPeriod": 20,
      "ReplenishmentPeriodSeconds": 10,
      "QueueLimit": 0
    },
    "Auth": {
      "TokenLimit": 10,
      "TokensPerPeriod": 2,
      "ReplenishmentPeriodSeconds": 15,
      "QueueLimit": 0
    }
  },
  "TestTokenSettings": {
    "Enabled": true,
    "HeaderName": "X-Alloc-Test-Token",
    "SecretToken": "your-secret-test-token-here"
  },
  "AvatarSettings": {
    "BaseUrl": "https://ui-avatars.com/api/"
  },
  "BackgroundJobs": {
    "ProfileCalculationBatchSize": 50
  }
}